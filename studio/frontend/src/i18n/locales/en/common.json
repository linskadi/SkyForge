			"signal_loss": {
				"name": "Signal Loss",
				"enName": "Signal Loss",
				"desc": "Forces input to 0 over an interval to simulate an open circuit"
			},
			"noise": {
				"name": "High-Frequency Noise",
				"enName": "Noise",
				"desc": "Adds random noise to simulate electromagnetic interference (EMI)"
			},
			"stuck": {
				"name": "Stuck-at Fault",
				"enName": "Stuck-at",
				"desc": "Freezes input at a fixed value to simulate mechanical jamming"
			},
			"step": {
				"name": "Step Change",
				"enName": "Step Change",
				"desc": "Input jumps at a given step to simulate rapid operating mode switch"
			},
			"saturation": {
				"name": "Saturation Clipping",
				"enName": "Saturation",
				"desc": "Values beyond limits are clipped, simulating ADC range limiting"
			},
			"glitch": {
				"name": "Glitch Spike",
				"enName": "Glitch",
				"desc": "Occasional instantaneous spikes to simulate latch-up effects"
			},
			"intermittent": {
				"name": "Intermittent Fault",
				"enName": "Intermittent",
				"desc": "Periodically alternates normal/abnormal values, simulating poor contact"
			},
			"timeout": {
				"name": "Frame Loss / Delay",
				"enName": "Timeout",
				"desc": "Signal freezes after a given point, simulating bus timeout frame loss"
			},
			"drift": {
				"name": "Gradual Drift",
				"enName": "Drift",
				"desc": "Linear offset over time, simulating component aging"
			},
			"stuck_zero": {
				"name": "Zero Output",
				"enName": "Stuck-at-Zero",
				"desc": "Output constant 0 after a given step, simulating sensor total failure"
			},
			"polarity": {
				"name": "Polarity Reversal",
				"enName": "Polarity Reversal",
				"desc": "Signal inverted, simulating reversed cabling or polarity error"
			}
		},
